{
  "name": "duckdb-for-sqltools",
  "displayName": "DuckDB for SQLTools",
  "description": "Query and explore DuckDB databases in VS Code with SQLTools",
  "version": "2.0.3",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "vscode": "^1.87.0",
    "node": ">=22.18.0"
  },
  "publisher": "MaksimPeterburgskiy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaksimPeterburgskiy/duckdb-for-sqltools"
  },
  "bugs": {
    "url": "https://github.com/MaksimPeterburgskiy/duckdb-for-sqltools/issues"
  },
  "qna": "https://github.com/MaksimPeterburgskiy/duckdb-for-sqltools/issues",
  "icon": "icons/duckdb-logo.png",
  "scripts": {
    "clean": "rimraf out dist coverage *.vsix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"test/integration/**\"",
    "test:integration": "vitest run test/integration",
    "test:all": "pnpm run test && pnpm run test:integration",
    "verify": "pnpm run typecheck && pnpm run test:all",
    "compile": "rimraf out && tsup src/extension.ts src/ls/plugin.ts -d out --external=vscode --external=cpu-features --external=./crypto/build/Release/sshcrypto.node",
    "watch": "rimraf out && tsup src/extension.ts src/ls/plugin.ts -d out --external=vscode --external=cpu-features --external=./crypto/build/Release/sshcrypto.node --watch",
    "vscode:prepublish": "pnpm run verify && pnpm run compile",
    "package": "vsce package --allow-star-activation --no-dependencies"
  },
  "keywords": [
    "sqltools-driver",
    "duckdb",
    "motherduck",
    "sqltools"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "extensionDependencies": [
    "mtxr.sqltools"
  ],
  "activationEvents": [
    "*",
    "onLanguage:sql",
    "onCommand:sqltools.*"
  ],
  "main": "./out/extension.js",
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@sqltools/base-driver": "0.2.4",
    "@sqltools/types": "0.2.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.87.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.3.0",
    "rimraf": "6.1.4",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
